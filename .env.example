# =================================================================
# PromptVault Environment Configuration Template
# =================================================================
# Rename this file to .env and provide your production credentials.

# Flask Application Secret Key (Used for CSRF token & session encryption)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# Environment Mode: 'production' or 'development'
FLASK_ENV=production
FLASK_DEBUG=0

# Server Bind Configuration
HOST=127.0.0.1
PORT=5000

# SQLite Database Storage Location
DATABASE_PATH=prompts.db

