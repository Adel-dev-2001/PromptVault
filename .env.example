# PromptVault Environment Configuration
# Copy to .env and set values for your deployment environment.

# Environment mode: development or production
APP_ENV=development

# Flask session and CSRF signing key (minimum 32 characters; required in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-key

# SQLite database file path (defaults to prompts.db in application root)
DATABASE_PATH=prompts.db

# Optional Basic auth password for POST actions (leave blank to keep disabled)
APP_PASSWORD=

# Local server bind settings
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Set to 1 behind a TLS-terminating reverse proxy so HTTPS detection works
TRUST_PROXY=0
